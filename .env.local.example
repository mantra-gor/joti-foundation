NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only — used by the Route Handlers under src/app/api/
# (src/lib/mailer.js) to send mail via Gmail SMTP.
# GMAIL_APP_PASSWORD is a Google Account app password, not your login password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

# Server-only — the Laravel mailbox app that staff triage submissions in
# (src/lib/mailbox.js). Never NEXT_PUBLIC_*: the token is a shared secret and
# these calls are server-to-server from the Route Handlers.
# Generate the token on the mailbox side with `php artisan mailbox:token`, then
# set the identical value here. If either var is unset, submissions still go out
# by email and the mailbox write is skipped with a warning.
MAILBOX_URL=https://mailbox.jotifoundation.org
MAILBOX_API_TOKEN=
